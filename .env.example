# Example environment variables for option_chain_builder.
# Copy this file to .env and fill in real values. .env must NEVER be committed.

# PostgreSQL connection string consumed by settings/config.py.
# Must include the password (the value is no longer hardcoded in source).
# Example: postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/options_db
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/options_db

# (Optional) OAuth credentials used by utils/ibkr_oauth.py
# CONSUMER_KEY=TESTCONS
# SIGNATURE_KEY_PATH=./signature_key.pem
# PRIVATE_ENCRYPTION_PATH=./private_encryption.pem
# DH_PARAM_PATH=./dhparam.pem